# Staging environment (create the Kubernetes secret from a filled-in copy; never commit it).
NODE_ENV=production
APP_ENV=staging
PUBLIC_URL=https://api.staging.example.in
WEB_URL=https://app.staging.example.in
CORS_ORIGINS=https://app.staging.example.in
DATABASE_URL=postgres://anvita:CHANGE_ME@staging-db:5432/anvita_staging
JWT_SECRET=CHANGE_ME_32_plus_random_chars
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
ANTHROPIC_API_KEY=
# Test-mode payment keys only on staging.
RAZORPAY_KEY_ID=rzp_test_…
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
SANDBOX_PROVIDER=docker
