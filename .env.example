# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
# api | worker | all (all = HTTP + job runner in one process)
ROLE=all
PORT=4000
LOG_LEVEL=info
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Data ─────────────────────────────────────────────────
DATABASE_URL=postgres://anvita:anvita@localhost:5432/anvita
DATABASE_POOL_MAX=10
# Run migrations automatically at boot (set false if you migrate in a release step)
MIGRATE_ON_START=true

# ── Security (REQUIRED in production) ────────────────────
# openssl rand -base64 48
JWT_SECRET=
# 32 bytes, base64 or hex: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Models ───────────────────────────────────────────────
# Without a key the deterministic "scripted" model is used (dev/demo/CI).
ANTHROPIC_API_KEY=
MODEL_ACT=claude-sonnet-5-5
MODEL_PLAN=claude-opus-5-5
MODEL_FAST=claude-haiku-5-5
AGENT_MAX_STEPS=24

# ── Jobs ─────────────────────────────────────────────────
JOBS_CONCURRENCY=4
SCHEDULER_ENABLED=true

# ── Email (optional; invites are logged when unset) ──────
RESEND_API_KEY=
EMAIL_FROM=Anvita <no-reply@anvita.ai>

SIGNUP_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=10
