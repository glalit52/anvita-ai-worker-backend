# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
# api | worker | all (all = HTTP + job runner in one process)
ROLE=all
PORT=4000
LOG_LEVEL=info
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Data ─────────────────────────────────────────────────
DATABASE_URL=postgres://anvita:anvita@localhost:5432/anvita
DATABASE_POOL_MAX=10
# Run migrations automatically at boot (set false if you migrate in a release step)
MIGRATE_ON_START=true

# ── Security (REQUIRED in production) ────────────────────
# openssl rand -base64 48
JWT_SECRET=
# 32 bytes, base64 or hex: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Models ───────────────────────────────────────────────
# Without a key the deterministic "scripted" model is used (dev/demo/CI).
ANTHROPIC_API_KEY=
MODEL_ACT=claude-sonnet-5-5
MODEL_PLAN=claude-opus-5-5
MODEL_FAST=claude-haiku-5-5
AGENT_MAX_STEPS=24

# ── Jobs ─────────────────────────────────────────────────
JOBS_CONCURRENCY=4
SCHEDULER_ENABLED=true

# ── Email (optional; invites are logged when unset) ──────
RESEND_API_KEY=
EMAIL_FROM=Anvita <no-reply@anvita.ai>

SIGNUP_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Connectors (OAuth apps) ──────────────────────────────
# Register <PUBLIC_URL>/v1/oauth/callback as the redirect URI in each provider's console.
# Apps not configured here can still connect with an API key/token (Integrations → Connect),
# or fall back to the labelled demo driver.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google Ads also needs a developer token (Google Ads API Center); Google OAuth client above.
GOOGLE_ADS_DEVELOPER_TOKEN=
# QuickBooks Online (Intuit developer app); set QUICKBOOKS_ENV=sandbox for sandbox companies.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=production
# Zoho CRM + Books (api-console.zoho.in); use the accounts URL of your data centre.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Tally, Darwinbox, Workday, PostgreSQL and the others connect with per-workspace credentials.
# Self-hosted inside a private network? Allow database/API hosts on private addresses:
CONNECTOR_ALLOW_PRIVATE_HOSTS=0

# ── Code sandbox ─────────────────────────────────────────
# docker (default in production): one throwaway container per run — no network, read-only root,
# CPU/memory/pid limits. Build the image from ./sandbox: docker build -t anvita-sandbox:latest sandbox
# process: local interpreter in a network-less namespace (development only). disabled: no code steps.
SANDBOX_PROVIDER=docker
SANDBOX_IMAGE=anvita-sandbox:latest
SANDBOX_TIMEOUT_MS=120000
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_MAX_CONCURRENCY=4

# ── Channels ─────────────────────────────────────────────
# Slack app → Event Subscriptions request URL: <PUBLIC_URL>/v1/hooks/slack/events
SLACK_SIGNING_SECRET=
# WhatsApp: per-connection credentials; Meta webhook URL: <PUBLIC_URL>/v1/hooks/whatsapp

# ── Single sign-on ───────────────────────────────────────
# Uses the Google/Microsoft clients above; also register
# <PUBLIC_URL>/v1/auth/sso/google/callback and <PUBLIC_URL>/v1/auth/sso/microsoft/callback

# ── Payments (unset → admins record top-ups manually) ────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook URL: <PUBLIC_URL>/v1/hooks/razorpay (events: order.paid, payment.captured)
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
# Stripe webhook URL: <PUBLIC_URL>/v1/hooks/stripe (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
CREDITS_PRICE_PER_1000=100
BILLING_CURRENCY=INR
