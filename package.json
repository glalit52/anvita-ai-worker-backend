{
  "name": "@anvita/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Anvita AI Workers backend: API, agent runtime, durable jobs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/sandbox/runtime && cp src/sandbox/runtime/runner.py src/sandbox/runtime/runner.mjs dist/sandbox/runtime/ && mkdir -p dist/channels/assets && cp src/channels/assets/widget.js dist/channels/assets/",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "start:api": "ROLE=api node --import ./dist/telemetry.js dist/main.js",
    "start:worker": "ROLE=worker node --import ./dist/telemetry.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:backup": "scripts/backup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-saml/node-saml": "^5.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@sentry/node": "^11.12.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.13",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "undici": "^7.30.1",
    "vitest": "^5.0.5",
    "xml-crypto": "^6.4.0"
  }
}
